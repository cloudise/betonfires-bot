# Скопируй в .env рядом с README. Никому не отправляй значения токенов.
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
# Альтернатива числовому ID для первого запуска с телефона:
# PAIRING_CODE — случайный секрет от 24 символов из настроек хоста.
PAIRING_CODE=
PANDASCORE_TOKEN=
BOT_DB=data/research.sqlite3
# Необязательно: сторонний источник линии BetBoom. Пароль БК не нужен.
API_SPORT_KEY=
# Включать только после разового betboom-sync и проверки покрытия/квоты.
BETBOOM_AUTO=0
# Частота импорта, секунды. Запросы расходуют квоту провайдера.
BETBOOM_POLL_SECONDS=300
